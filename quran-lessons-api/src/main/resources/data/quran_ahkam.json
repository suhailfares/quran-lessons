{
  "version": "1.0",
  "riwayah": "Hafs 'an Asim",
  "rules": [
    {
      "group": "nun_sakinah_tanwin",
      "items": [
        {
          "code": "nst.izhar",
          "label": "Iẓhār",
          "when": "nun_sakinah_or_tanwin_followed_by_any_of_letters",
          "letters": ["ء","ه","ع","ح","غ","خ"],
          "effect": "clear_nasal_sound_without_merge"
        },
        {
          "code": "nst.idgham_ghunnah",
          "label": "Idghām (with ghunnah)",
          "when": "nun_sakinah_or_tanwin_followed_by_any_of_letters",
          "letters": ["ي","ن","م","و"],
          "effect": "merge_with_nasalization"
        },
        {
          "code": "nst.idgham_no_ghunnah",
          "label": "Idghām (without ghunnah)",
          "when": "nun_sakinah_or_tanwin_followed_by_any_of_letters",
          "letters": ["ل","ر"],
          "effect": "merge_without_nasalization"
        },
        {
          "code": "nst.iqlab",
          "label": "Iqlāb",
          "when": "nun_sakinah_or_tanwin_before",
          "letters": ["ب"],
          "effect": "convert_to_mim_with_hidden_ghunnah"
        },
        {
          "code": "nst.ikhfa",
          "label": "Ikhfā’",
          "when": "nun_sakinah_or_tanwin_followed_by_any_of_letters",
          "letters": ["ص","ذ","ث","ك","ج","ش","ق","س","د","ط","ز","ف","ت","ض","ظ"],
          "effect": "concealed_nasalization_between_clear_and_merge"
        }
      ]
    },
    {
      "group": "mim_sakinah",
      "items": [
        {
          "code": "ms.ikhfa_shafawi",
          "label": "Ikhfā’ Shafawī",
          "when": "mim_sakinah_before",
          "letters": ["ب"],
          "effect": "concealed_nasalization_on_mim"
        },
        {
          "code": "ms.idgham_shafawi",
          "label": "Idghām Shafawī",
          "when": "mim_sakinah_followed_by",
          "letters": ["م"],
          "effect": "merge_with_complete_ghunnah"
        },
        {
          "code": "ms.izhar_shafawi",
          "label": "Iẓhār Shafawī",
          "when": "mim_sakinah_followed_by_any_letter_except",
          "letters_excluded": ["ب","م"],
          "effect": "clear_pronunciation"
        }
      ]
    },
    {
      "group": "mushaddadah",
      "items": [
        {
          "code": "mush.nun_mim_mushaddadah",
          "label": "Nūn/Mīm Mushaddadah",
          "when": "nun_or_mim_with_shaddah",
          "effect": "compulsory_ghunnah"
        }
      ]
    },
    {
      "group": "qalqalah",
      "items": [
        {
          "code": "qalqalah.general",
          "label": "Qalqalah",
          "when": "letter_is_sakin",
          "letters": ["ق","ط","ب","ج","د"],
          "effect": "echoing_release_sound",
          "notes": "stronger_at_pause"
        }
      ]
    },
    {
      "group": "tafkhim_tarqiq",
      "items": [
        {
          "code": "tt.heavy_letters",
          "label": "Always-heavy letters",
          "letters": ["خ","ص","ض","غ","ط","ق","ظ"],
          "effect": "tafkhim"
        },
        {
          "code": "tt.ra_rules",
          "label": "Rā’ rules",
          "when": "contextual",
          "effect": "tafkhim_or_tarqiq",
          "notes": "heavy with fatḥah/ḍammah; light with kasrah; see detailed contexts"
        },
        {
          "code": "tt.lam_of_allah",
          "label": "Lām of “Allah”",
          "when": "preceded_by_fathah_or_dammah_then_allah",
          "effect": "tafkhim",
          "notes": "light if preceded by kasrah"
        },
        {
          "code": "tt.alif_follows_previous",
          "label": "Alif follows previous",
          "when": "alif_maddah",
          "effect": "takes_heaviness_or_lightness_of_previous_letter"
        }
      ]
    },
    {
      "group": "madd",
      "items": [
        {
          "code": "madd.asli",
          "label": "Madd Aṣlī",
          "cause": "none_basic_madd_letter",
          "counts": [2]
        },
        {
          "code": "madd.muttasil",
          "label": "Madd Muttasil",
          "cause": "hamzah_after_madd_letter_same_word",
          "counts": [4,5]
        },
        {
          "code": "madd.munfasil",
          "label": "Madd Munfasil",
          "cause": "madd_letter_end_word_hamzah_begin_next",
          "counts": [4,5]
        },
        {
          "code": "madd.badal",
          "label": "Madd Badal",
          "cause": "hamzah_then_madd_letter",
          "counts": [2]
        },
        {
          "code": "madd.lazim",
          "label": "Madd Lāzim",
          "cause": "real_or_lexical_sukun_after_madd_letter",
          "counts": [6]
        },
        {
          "code": "madd.arid_lissukun",
          "label": "Madd ʿĀriḍ lis-sukūn",
          "cause": "temporary_sukun_due_to_pause",
          "counts": [2,4,6]
        },
        {
          "code": "madd.lin",
          "label": "Madd Līn",
          "cause": "preceded_by_fathah_then_waw_or_ya_sakin_and_pause",
          "counts": [2,4,6]
        }
      ]
    },
    {
      "group": "hamzat",
      "items": [
        {
          "code": "hamz.wasl",
          "label": "Hamzat al-Waṣl",
          "when": "drops_in_continuous_speech",
          "effect": "pronounced_only_when_starting"
        },
        {
          "code": "hamz.qat",
          "label": "Hamzat al-Qaṭʿ",
          "when": "always_pronounced",
          "effect": "glottal_stop_present"
        }
      ]
    },
    {
      "group": "lam_shamsiyyah_qamariyyah",
      "items": [
        {
          "code": "lam.sun",
          "label": "Lām Shamsiyyah (assimilation)",
          "sun_letters": ["ت","ث","د","ذ","ر","ز","س","ش","ص","ض","ط","ظ","ل","ن"]
        },
        {
          "code": "lam.moon",
          "label": "Lām Qamariyyah (manifest)",
          "moon_letters": ["ا","ب","ج","ح","خ","ع","غ","ف","ق","ك","م","ه","و","ي"]
        }
      ]
    },
    {
      "group": "waqf_ibtida",
      "items": [
        {
          "code": "waqf.signs",
          "label": "Common pause signs",
          "signs": ["م","لا","ج","ط","ز","صلى","قلى"],
          "notes": "meanings vary by mushaf; include start/stop guidance"
        }
      ]
    },
    {
      "group": "sifat_al_huruf",
      "items": [
        {
          "code": "sifat.hams",
          "label": "Hams (breath)",
          "letters": ["ف","ح","ث","ه","ش","خ","ص","س","ك","ت"]
        },
        {
          "code": "sifat.jahr",
          "label": "Jahr (voicing)",
          "letters": "all_other_letters"
        },
        {
          "code": "sifat.shiddah",
          "label": "Shiddah (strength)",
          "letters": ["ء","ج","د","ق","ط","ب","ك","ت"]
        },
        {
          "code": "sifat.tawassut",
          "label": "Tawassuṭ (medium)",
          "letters": ["ل","ن","ع","م","ر"]
        },
        {
          "code": "sifat.rikhwah",
          "label": "Rikhwah (softness)",
          "letters": "all_except_shiddah_and_tawassut"
        }
      ]
    }
  ]
}
